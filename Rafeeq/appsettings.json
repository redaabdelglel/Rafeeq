{
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=.;Initial Catalog=Rafeeq;Integrated Security=True;TrustServerCertificate=True"
    },
    "Jwt": {
        "Key": "ThisIsYourSuperSecretKeyForTokenValidationShouldBeAtLeast32Chars",
        "Issuer": "RafeeqApi",
        "Audience": "RafeeqApp",
        "ExpirationInMinutes": 60
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    {
        "GoogleMeetSettings": {
            "CredentialsFilePath": "credentials.json", // or full path like "C:\\path\\to\\credentials.json"
            "Scopes": [ "https://www.googleapis.com/auth/calendar" ]
        }
    }
}
